---
import { type CollectionEntry, getCollection } from 'astro:content'
import PostLayout from '@/layouts/PostLayout.astro'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const reviews = await getCollection('reviews')

  return reviews
    .filter((entry) => !entry.id.startsWith('_'))
    .map((entry) => ({
      params: { slug: entry.id },
      props: entry
    }))
}

// 💡 1. Props를 any로 받거나, Astro가 넘겨주는 데이터 구조에 맞게 처리합니다.
const reviews = Astro.props as any

// 💡 2. render 함수에 전달할 때 타입 에러가 나지 않도록 합니다.
const { Content, remarkPluginFrontmatter } = await render(reviews)

const readingTime = remarkPluginFrontmatter?.readingTime
const toc = remarkPluginFrontmatter?.toc || []
---

{/* 💡 3. reviews.data가 확실히 존재함을 보장하며 데이터를 넘겨줍니다. */}
<PostLayout {...reviews.data} readingTime={readingTime} toc={toc}>
  <Content />
</PostLayout>
