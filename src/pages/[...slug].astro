---
import { type CollectionEntry, getCollection } from 'astro:content'
import PostLayout from '@/layouts/PostLayout.astro'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects
    .filter((entry) => !entry.id.startsWith('_'))
    .map((entry) => ({
      params: { slug: entry.id },
      props: entry
    }))
}

type Props = CollectionEntry<'projects'>

const projects = Astro.props
const { Content, remarkPluginFrontmatter } = await render(projects)

const readingTime = remarkPluginFrontmatter.readingTime
const toc = remarkPluginFrontmatter.toc || []
---

<PostLayout {...projects.data} readingTime={readingTime} toc={toc}>
  <Content />
</PostLayout>