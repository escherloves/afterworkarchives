---
import { type CollectionEntry, getCollection } from 'astro:content'
import PostLayout from '@/layouts/PostLayout.astro'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const logEntries = await getCollection('log')

  return logEntries
    .filter((entry) => !entry.id.startsWith('_'))
    .map((entry) => ({
      params: { slug: entry.id },
      props: entry
    }))
}

// 💡 1. Astro.props를 any로 캐스팅하여 데이터 접근 권한을 확보합니다.
const log = Astro.props as any

// 💡 2. render 함수에 캐스팅된 객체를 전달합니다.
const { Content, remarkPluginFrontmatter } = await render(log)

// 💡 3. 데이터가 없을 경우를 대비해 옵셔널 체이닝(?.)과 기본값을 설정합니다.
const readingTime = remarkPluginFrontmatter?.readingTime
const toc = remarkPluginFrontmatter?.toc || []
---

{/* 💡 4. log.data의 속성들을 안전하게 전개하여 레이아웃에 전달합니다. */}
<PostLayout {...log.data} readingTime={readingTime} toc={toc}>
  <Content />
</PostLayout>
