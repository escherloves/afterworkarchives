---
import IndexLayout from '@/layouts/IndexLayout.astro'
import About from '@/components/widgets/About.astro'
// 기존 PostList 대신 우리가 직접 목록을 컨트롤합니다.
import { themeConfig } from '@/config'
import { getCollection } from 'astro:content'

// 1. 모든 카테고리에서 글 가져오기
const logs = await getCollection('log')
const reviews = await getCollection('reviews')
const works = await getCollection('works')

// 2. 데이터 합치고 정렬하기
const allPosts = [
  ...logs.map((p) => ({ ...p, category: 'Log' })),
  ...reviews.map((p) => ({ ...p, category: 'Reviews' })),
  ...works.map((p) => ({ ...p, category: 'Works' })) // projects 대신 Works로 표시
]
  // 💡 이 부분이 핵심입니다! id가 '_'로 시작하는 것은 제외(filter)합니다.
  .filter((post) => !post.id.startsWith('_'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
---

<IndexLayout title={themeConfig.site.title} description={themeConfig.site.description}>
  <About />

  <main>
    <ul class="custom-post-list">
      {
        allPosts.map((post) => (
          <li class="custom-post-item">
            <a href={`/${post.category.toLowerCase()}/${post.id}`} class="post-link">
              <span class="post-title">{post.data.title}</span>
              <div class="post-meta">
                <span class="post-category">{post.category}</span>
                <span class="post-divider" />
                <span class="post-date">
                  {post.data.pubDate
                    .toLocaleDateString('ko-KR', {
                      year: 'numeric',
                      month: '2-digit',
                      day: '2-digit'
                    })
                    .replace(/\s/g, '')
                    .slice(0, -1)}
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</IndexLayout>

<style>
  /* 현재 테마의 정갈함을 유지하는 스타일 */
  .custom-post-list {
    list-style: none;
    padding: 0;
    margin-top: 2rem;
  }
  .custom-post-item {
    margin-bottom: 0.75rem;
  }
  .post-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    color: var(--text-primary);
    transition: opacity 0.2s;
  }
  .post-link:hover {
    opacity: 0.5;
  }
  .post-title {
    font-weight: 500;
    flex-shrink: 0;
  }
  .post-meta {
    display: flex;
    align-items: center;
    flex-grow: 1;
    margin-left: 1rem;
    gap: 0.75rem;
  }
  .post-category {
    font-size: 0.75rem;
    opacity: 0.4;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .post-divider {
    flex-grow: 1;
    height: 1px;
    border-bottom: 1px dotted var(--text-secondary);
    opacity: 0.2;
  }
  .post-date {
    font-size: 0.85rem;
    opacity: 0.5;
    font-variant-numeric: tabular-nums;
  }
</style>
